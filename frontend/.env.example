# Local dev: same port as backend/.env PORT (default 5555)
VITE_API_BASE_URL=http://localhost:5555/api
# Production example:
# VITE_API_BASE_URL=https://your-backend.onrender.com/api

# Client-side summary LLM (Groq — OpenAI-compatible chat). Create a key at https://console.groq.com/
VITE_GROQ_API_KEY=
# Optional; default in code is llama-3.1-8b-instant. See Groq model list in console.
# VITE_GROQ_MODEL=llama-3.3-70b-versatile
