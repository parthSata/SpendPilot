NODE_ENV=development
PORT=5000
# Local: default below. Production (Render/Vercel/etc.): use MongoDB Atlas — never 127.0.0.1 on the host.
# Example Atlas: MONGO_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/spendpilot?retryWrites=true&w=majority
MONGO_URI=
FRONTEND_ORIGIN=http://localhost:8080,http://localhost:5173,https://spend-pilot-sigma.vercel.app
ACCESS_TOKEN_SECRET=replace_with_strong_secret
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=replace_with_strong_secret
REFRESH_TOKEN_EXPIRY=7d
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
